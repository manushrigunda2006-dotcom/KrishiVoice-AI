# KrishiVoice AI 2.0 Environment Configuration
PORT=3000

# Gnani.ai API Configuration (api.vachana.ai)
GNANI_API_KEY=replace_with_your_key

# Gnani Prisma STT (Speech-to-Text) Settings
# Documentation: https://api.vachana.ai/stt/v3
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0

# Gnani Timbre TTS (Text-to-Speech) Settings
# Documentation: https://api.vachana.ai/api/v1/tts/inference
# Supported Kannada voices in timbre-v3.0: Lakshmi, Kalpana, Chetana, Shivani, Vasudha, Avinash, Prakash
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_VOICE=Lakshmi
