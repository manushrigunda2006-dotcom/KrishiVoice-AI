# Copy this file to .env and add your Gnani API key.
GNANI_API_KEY=replace_with_your_key
PORT=3000

# Gnani Prisma STT endpoint. Confirm current endpoint/settings in your dashboard.
GNANI_STT_URL=https://api.vachana.ai/stt/v3

# Optional: TTS is deliberately not enabled until you confirm the voice,
# model and endpoint available to your Gnani account.
